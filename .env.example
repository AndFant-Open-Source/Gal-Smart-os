# Copiare in .env e compilare. Il file .env non va mai pubblicato (è in .gitignore).
# In produzione (Cloudflare Pages) le stesse variabili si inseriscono in
# Settings → Environment variables, una configurazione per ogni GAL.

# Supabase del GAL — Project Settings → API (usare SOLO la chiave "anon public", mai la service_role)
VITE_SUPABASE_URL=https://xxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Nome del GAL mostrato nella pagina di accesso
VITE_NOME_ENTE=Nome del GAL

# Indirizzo pubblico del codice sorgente, mostrato a piè di pagina
# (Linee guida AgID su acquisizione e riuso del software, Allegato A §A.2; AGPL sezione 13)
VITE_URL_CODICE_SORGENTE=https://github.com/AndFant-Open-Source/Gal-Smart-os
